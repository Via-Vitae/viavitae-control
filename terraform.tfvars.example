# Copy to terraform.tfvars and adjust. NEVER commit real secrets to tfvars.
# The GitHub token is provided via the GITHUB_TOKEN environment variable, not here.

github_owner     = "Via-Vitae"
# billing_email: use the dedicated GitHub-org plus-address stream.
# See README.md § Communication addresses. Keep the real value in
# terraform.tfvars (gitignored); NEVER commit it here.
billing_email    = "<viavitae.github plus-address>"  # required — no default (GDPR Art. 5(1)(c))
github_plan_tier = "free"   # free | team | enterprise — flipping this activates gated controls

# --- Control flags -----------------------------------------------------------
enable_secret_scanning             = true
enable_push_protection             = true
enable_advanced_security           = false  # requires enterprise
enable_branch_protection           = true
enable_private_branch_protection   = true   # effective only on team/enterprise
enable_dependabot_alerts           = true
enable_dependabot_security_updates = true
enable_sso                         = false  # requires enterprise + policies/enforce_sso.sh

# --- Branch protection review model -----------------------------------------
# Single-member org today: keep review count 0 to avoid locking out the sole admin.
# Raise to 1 (and code-owner review true) once a second member/team exists.
branch_required_approving_review_count = 0
branch_require_code_owner_reviews      = false
branch_enforce_admins                  = true
branch_require_last_push_approval      = false

# Required status checks. Names are matched EXACTLY (case-sensitive) against the
# check a workflow reports; "strict" without a listed context gates nothing, and a
# listed context no job reports freezes every PR in that repo. Measured live on
# 2026-10-15 (undeclared by this repo, see docs/COMPLIANCE.md P1-13):
#   most repos            = ["CI status", "Compliance status"]
#   viavitae-web          = ["Analyze (javascript-typescript)", "Action SHA pinning",
#                            "Governance files", "CI status", "Compliance status"]
#   Via-Vitae/.github     = ["CI status"]
#   viavitae-demos        = kebab-case names its jobs never report  -> frozen
#   viavitae-qa           = includes "CI status", which its ci.yml does not produce
# branch_required_status_checks_contexts = ["CI status", "Compliance status"]
branch_required_status_checks_contexts = []

# --- Allowed Actions policy --------------------------------------------------
actions_allowed_mode = "selected"   # all | selected | disabled
# actions_allowed_patterns = [ ... ]  # see variables.tf defaults

# --- Org member permissions (defaults preserve current live values) ----------
default_repository_permission        = "read"
members_can_create_repositories       = true
members_can_create_public_repositories = true

# --- Adoption of existing repos ---------------------------------------------
import_existing_repos = true

# --- Organization-level data reads (opt-in) ----------------------------------
# Keep false in CI: the plan then reads no organization full-detail field, so it
# needs no organization-admin credential for them. (The provider still issues one
# GET /orgs/{org} at configure time regardless of this flag; that needs only org
# visibility.) Set true only for an operator-local plan run, where the org
# full-detail read and the 2FA plan-time assertion are wanted. Out-of-band
# verification is scripts/assert_org_2fa.sh either way.
manage_org_data = false

# --- S3 backend (only used when state/backend_s3.tf.example is enabled) ------
# state_s3_bucket = "viavitae-tfstate-bootstrap"
# state_s3_key    = "viavitae-control/terraform.tfstate"
# state_s3_region = "eu-central-1"
